κώΰΧ 343fc9b7d9d5bf16cb182b6aa49ff3c9

5dbt_sales_hub/models/staging/stg_sales__customers.sqlΆSELECT
    CUSTOMER_RAW_ROW_ID::NUMBER       AS customer_raw_row_id
    ,CUSTOMER_ID::VARCHAR              AS customer_id
    ,CUSTOMER_NAME::VARCHAR            AS customer_name
    ,COUNTRY_CODE::VARCHAR              AS country_code
    ,CUSTOMER_SEGMENT::VARCHAR          AS customer_segment
    ,PRIMARY_SALES_REP_ID::VARCHAR      AS primary_sales_rep_id

    ,ONBOARDING_DATE::DATE              AS onboarding_date
    ,VALID_FROM::DATE                   AS valid_from
    ,VALID_TO::DATE                     AS valid_to

    ,MD_CHANGE_REASON::VARCHAR          AS md_change_reason

    ,(case when IS_INTERNAL_TEST_ACCOUNT = 1 then TRUE else FALSE end)  AS is_internal_test_account

    ,CREDIT_LIMIT_EUR::NUMBER(18,2)     AS credit_limit_eur
    

FROM {{ source('sales_raw', 'RAW_CUSTOMERS') }}

*
ώαΧ 572149a0b2f9838f3174d0068744c402
β
2dbt_sales_hub/models/staging/stg_sales__orders.sqlÿSELECT
    PRODUCT_ID::VARCHAR                      AS product_id
    ,PRODUCT_NAME::VARCHAR                   AS product_name
    ,PRODUCT_CATEGORY::VARCHAR               AS product_category
    ,SERVICE_FEE_PCT::NUMBER(10,4)           AS service_fee_pct
    ,STANDARD_UNIT_PRICE_EUR::NUMBER(18,2)   AS standard_unit_price_eur
    ,(case when IS_ACTIVE_PRODUCT = 1 then TRUE else FALSE end) AS is_active_product
    ,LEGACY_SAP_MATERIAL_NO::VARCHAR         AS legacy_sap_material_no
    ,dense_rank() over (partition by order_id order by sys_ingestion_ts desc) rn
FROM {{ source('sales_raw', 'RAW_PRODUCTS_CONTRACTS') }}
qualify rn = 1


*
­ύαΧ c0b8357282db91f45e19c901cacb8dad
Χ
4dbt_sales_hub/models/staging/stg_sales__products.sqlςSELECT
        ORDER_ID::VARCHAR                   AS order_id,
        ORDER_DATE::DATE                    AS order_date,
        CUSTOMER_ID::VARCHAR                AS customer_id,
        PRODUCT_ID::VARCHAR                 AS product_id,
        ORDER_STATUS::VARCHAR               AS order_status,
        ORDER_TYPE::VARCHAR                 AS order_type,

        CURRENCY::VARCHAR                   AS currency,
        FX_RATE_TO_EUR::NUMBER(18,6)        AS fx_rate_to_eur,

        QUANTITY::NUMBER(18,4)              AS quantity,
        GROSS_AMOUNT_LOCAL::NUMBER(18,2)    AS gross_amount_local,
        DISCOUNT_AMOUNT_LOCAL::NUMBER(18,2) AS discount_amount_local,
        TAX_AMOUNT_LOCAL::NUMBER(18,2)      AS tax_amount_local,

        SALES_CHANNEL::VARCHAR              AS sales_channel,

        SYS_INGESTION_TS::TIMESTAMP_NTZ     AS sys_ingestion_ts,
        RAW_KAFKA_OFFSET_ID::NUMBER         AS raw_kafka_offset_id,
        dens

    FROM {{ source('sales_raw', 'RAW_SALES_ORDERS') }}

*
¨ύαΧ 9372088e93900b9aee72f63fa120744e
Ω
3dbt_sales_hub/models/staging/stg_sales__targets.sqlυSELECT
    TARGET_ROW_ID::NUMBER                  AS target_row_id
    ,TARGET_MONTH::DATE                     AS target_month
    ,COUNTRY_CODE::VARCHAR                  AS country_code

    ,TARGET_NET_REVENUE_EUR::NUMBER(18,2)   AS target_net_revenue_eur
    ,TARGET_NEW_CUSTOMERS::NUMBER           AS target_new_customers

    ,TARGET_VERSION::VARCHAR                AS target_version
    ,APPROVED_BY::VARCHAR                   AS approved_by

FROM {{ source('sales_raw', 'RAW_SALES_TARGETS') }}
