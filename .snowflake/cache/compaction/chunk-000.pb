ΤΦαΧ e25744b32440bb8d822fca55f632aeb7
Ò
Untitled.sql•SELECT
    CURRENT_ROLE(),
    CURRENT_WAREHOUSE(),
    CURRENT_DATABASE(),
    CURRENT_SCHEMA();


    CREATE DATABASE IF NOT EXISTS DKV_SALES_HUB;

CREATE SCHEMA IF NOT EXISTS DKV_SALES_HUB.RAW;

CREATE SCHEMA IF NOT EXISTS DKV_SALES_HUB.STAGING;

CREATE SCHEMA IF NOT EXISTS DKV_SALES_HUB.INTERMEDIATE;

CREATE SCHEMA IF NOT EXISTS DKV_SALES_HUB.MARTS;


-- DKV Sales Data Hub
-- Git integration test

